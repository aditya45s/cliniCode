{
  "name": "carekare",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/frontend", "apps/backend"],
  "scripts": {
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:web": "npm run dev:frontend",
    "dev:api": "npm run dev:backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:web": "npm run build:frontend",
    "build:api": "npm run build:backend",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm --prefix apps/backend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  }
}
